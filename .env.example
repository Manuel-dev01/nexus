# ============================================================
# Nexus — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Tatum API ---
TATUM_API_KEY=your_tatum_api_key_here

# --- Sui Network ---
# Options: testnet | mainnet | devnet
SUI_NETWORK=testnet

# Tatum RPC Gateway (auto-set based on SUI_NETWORK, but can override)
SUI_RPC_URL=https://sui-testnet.gateway.tatum.io

# Sui wallet private key (base64-encoded Ed25519 secret key)
# Used by scripts and MCP server for signing transactions
SUI_PRIVATE_KEY=your_base64_private_key_here

# --- Walrus Storage ---
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
WALRUS_UPLOAD_RELAY_URL=https://upload-relay.testnet.walrus.space

# --- Move Contract (populated after deployment) ---
NEXUS_PACKAGE_ID=
NEXUS_MARKETPLACE_ID=

# --- Frontend ---
PUBLIC_SUI_NETWORK=testnet
PUBLIC_TATUM_RPC_URL=https://sui-testnet.gateway.tatum.io
PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
