# Nexus Frontend Environment Variables

# Tatum RPC Gateway
PUBLIC_TATUM_RPC_URL=https://sui-testnet.gateway.tatum.io
PUBLIC_TATUM_API_KEY=your_tatum_api_key_here

# Sui Network
PUBLIC_SUI_NETWORK=testnet

# Nexus Contract Addresses (after deployment)
PUBLIC_NEXUS_PACKAGE_ID=
PUBLIC_NEXUS_MARKETPLACE_ID=

# Walrus Endpoints (defaults to testnet)
PUBLIC_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
PUBLIC_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
